// Banco de dados do app de gestão de diaristas.
// Em desenvolvimento usamos Postgres local; em produção, o Postgres da Vercel.
// Valores em dinheiro são guardados em CENTAVOS (inteiro) para evitar erros de arredondamento.
// Datas de trabalho são guardadas como texto "AAAA-MM-DD" para evitar confusão de fuso horário.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Em runtime usamos a conexão "pooled" (com pgbouncer).
  // Nomes criados automaticamente pela integração Vercel + Supabase.
  url       = env("POSTGRES_PRISMA_URL")
  // Para rodar migrations precisamos de uma conexão direta (sem pooler).
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Loja {
  id          String       @id @default(cuid())
  nome        String
  cnpj        String?
  senha       String       @default("123456") // hash da senha (login por nome + senha)
  tokenSenha  String?      @unique // link secreto p/ definir/resetar a senha (1º acesso)
  cidade      String?
  bairro      String?
  endereco    String?
  latitude    Float?
  longitude   Float?
  ativo       Boolean      @default(true)
  // Se true, a loja assume o risco e permite o mesmo diarista fazer mais de 2 diárias na semana.
  permiteMais2Semana Boolean @default(false)
  fotos       String[]     @default([]) // até 5 fotos do ambiente (URLs)
  vantagens   String? // texto com as vantagens de fazer diária nesta loja
  criadoEm    DateTime     @default(now())
  gestores    Gestor[]     @relation("GestorLojas") // uma loja pode ter vários gestores (sócios)
  escalas     Escala[]
  requisicoes Requisicao[]
  avaliacoesRecebidas AvaliacaoLoja[]
  bloqueios   Bloqueio[]
  convocacoes Convocacao[]
  diaristasPreferem Diarista[] @relation("LojaPreferida")
  diaristasNoBanco BancoLoja[]
  pushLojas   PushLoja[]
  // Painel do Gestor: a mesma loja vista pelo outro app (opcional).
  painel      Store?
}

// Banco/pool de diaristas de cada loja: só os diaristas listados aqui podem
// ser alocados/convocados por aquela loja (ou gestor dela). RH/TI veem todas.
// Diaristas entram aqui via: cadastro vindo do link da loja, aprovação por
// gestor/loja, ou (na migração) histórico de escalas.
model BancoLoja {
  lojaId     String
  diaristaId String
  criadoEm   DateTime @default(now())
  loja       Loja     @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  diarista   Diarista @relation(fields: [diaristaId], references: [id], onDelete: Cascade)

  @@id([lojaId, diaristaId])
  @@index([lojaId])
  @@index([diaristaId])
}

// Inscrição de push da loja/gestor (para lembrete de pagamento, etc.).
model PushLoja {
  id       String   @id @default(cuid())
  endpoint String   @unique
  p256dh   String
  auth     String
  criadoEm DateTime @default(now())
  lojaId   String
  loja     Loja     @relation(fields: [lojaId], references: [id], onDelete: Cascade)

  @@index([lojaId])
}

// Valor padrão da diária por função (definido pelo RH).
model ValorFuncao {
  id     String @id @default(cuid())
  funcao String @unique
  valor  Int    @default(0) // centavos
}

// Gestor: pessoa que administra uma ou mais lojas. Loga com usuário + senha.
model Gestor {
  id         String   @id @default(cuid())
  nome       String
  usuario    String   @unique
  senha      String   @default("123456")
  tokenSenha String?  @unique // link secreto p/ definir/resetar a senha
  telefone   String? // WhatsApp (para receber o link de acesso)
  aprovado   Boolean  @default(true) // autocadastro entra como false até o RH/TI aprovar
  ativo      Boolean  @default(true)
  criadoEm   DateTime @default(now())
  lojas      Loja[]   @relation("GestorLojas")
}

// Pessoa da equipe interna (RH ou TI). Loga clicando no nome + senha.
model Membro {
  id         String   @id @default(cuid())
  nome       String
  usuario    String   @unique
  perfil     String // "rh" | "ti"
  papel      String?
  senha      String? // hash; null = primeiro acesso (define a senha pelo link)
  tokenSenha String?  @unique // link secreto p/ definir/resetar a senha
  ativo      Boolean  @default(true)
  criadoEm   DateTime @default(now())
}

model Diarista {
  id          String      @id @default(cuid())
  nome        String
  cpf         String?
  dataNascimento String? // "AAAA-MM-DD"
  fotoUrl     String?
  funcao      String? // Atendente | Pizzaiolo | Aux. pizzaiolo | Motoqueiro
  telefone    String?
  senha       String? // hash da senha (definida no primeiro acesso)
  chavePix    String?
  valorDiaria Int         @default(0) // centavos
  observacoes String?
  ativo       Boolean     @default(true)
  // Aprovação do RH para quem se autocadastrou pelo link. Cadastros antigos e os
  // criados pelo próprio RH nascem aprovados (default true); autocadastro entra como false.
  aprovado    Boolean     @default(true)
  // Bloqueio GLOBAL (RH): a diarista não recebe nenhuma diária enquanto estiver no futuro.
  // null = não bloqueada. Data bem distante = "para sempre".
  bloqueadoAte DateTime?
  // Motivo do bloqueio global (lista negra), para o RH lembrar depois.
  motivoBloqueio String?
  token       String      @unique @default(cuid()) // usado no link pessoal /d/[token]
  telegramChatId String? // vinculado quando a diarista inicia o bot do Telegram
  criadoEm    DateTime    @default(now())
  escalas     Escala[]
  avaliacoes  Avaliacao[]
  avaliacoesDeLoja AvaliacaoLoja[]
  inscricoes  Inscricao[]
  bloqueios   Bloqueio[]
  convocacoes Convocacao[]
  bonificacoes Bonificacao[]
  convidadoEm Requisicao[] @relation("ConvidadosRequisicao")
  pushSubscriptions PushSubscription[]
  mensagens   Mensagem[]
  // Lojas que a diarista prefere trabalhar (apenas um norte, não obriga).
  lojasPreferidas Loja[] @relation("LojaPreferida")
  // Lojas no banco/escopo desta diarista — só essas lojas/gestores podem
  // alocar/convocar. (RH/TI veem todas.) Vazio = orfão, visível só pelo RH.
  lojasNoBanco BancoLoja[]
}

// Chat entre o diarista e o RH (avisos, dúvidas, imprevistos).
model Mensagem {
  id         String   @id @default(cuid())
  autor      String // DIARISTA | GESTAO
  texto      String
  lida       Boolean  @default(false)
  criadoEm   DateTime @default(now())
  diaristaId String
  diarista   Diarista @relation(fields: [diaristaId], references: [id], onDelete: Cascade)

  @@index([diaristaId])
}

// Inscrição de push web (um aparelho/navegador do diarista).
model PushSubscription {
  id         String   @id @default(cuid())
  endpoint   String   @unique
  p256dh     String
  auth       String
  criadoEm   DateTime @default(now())
  diaristaId String
  diarista   Diarista @relation(fields: [diaristaId], references: [id], onDelete: Cascade)

  @@index([diaristaId])
}

// Bonificação paga ao diarista: cashback (5 diárias com média alta) ou top do mês.
model Bonificacao {
  id         String    @id @default(cuid())
  tipo       String // CASHBACK_5 | TOP_MES
  valor      Int       @default(10000) // centavos (R$ 100,00)
  referencia String? // ex.: "2026-05" para o top do mês
  pago       Boolean   @default(false)
  pagoEm     DateTime?
  criadoEm   DateTime  @default(now())

  diaristaId String
  diarista   Diarista @relation(fields: [diaristaId], references: [id], onDelete: Cascade)

  @@index([diaristaId])
}

model Escala {
  id          String    @id @default(cuid())
  data        String // "AAAA-MM-DD"
  horaInicio  String? // "HH:MM"
  horaFim     String? // "HH:MM"
  valor       Int // centavos
  presenca    String    @default("PENDENTE") // PENDENTE | PRESENTE | FALTOU
  confirmadaEm DateTime? // diarista confirmou que vem (não é "realizada")
  pago        Boolean   @default(false)
  pagoEm      DateTime?
  observacoes String?
  tokenConfirmacao String? @unique // link público de confirmação (gerado pelo RH)
  checkinEm   DateTime?
  checkinLat  Float?
  checkinLng  Float?
  checkoutEm  DateTime?
  checkoutAuto Boolean  @default(false)
  valorPago   Int? // valor efetivo (proporcional se saiu antes); null até o check-out
  criadoEm    DateTime  @default(now())

  diaristaId String
  diarista   Diarista @relation(fields: [diaristaId], references: [id], onDelete: Cascade)
  lojaId     String
  loja       Loja     @relation(fields: [lojaId], references: [id], onDelete: Cascade)

  requisicaoId String?
  requisicao   Requisicao? @relation(fields: [requisicaoId], references: [id], onDelete: SetNull)

  avaliacao     Avaliacao?
  avaliacaoLoja AvaliacaoLoja?

  @@unique([diaristaId, data]) // 1 diária por diarista por dia (trava o furo de escala)
  @@index([data])
  @@index([lojaId])
}

// Pedido de diaristas feito por uma loja; o RH atende criando as escalas.
model Requisicao {
  id          String   @id @default(cuid())
  data        String // "AAAA-MM-DD" - dia em que a loja precisa
  horaInicio  String // "HH:MM"
  horaFim     String // "HH:MM"
  funcao      String? // função desejada (opcional)
  quantidade  Int      @default(1)
  valorDiaria Int // centavos - valor pago por diarista nessa requisição
  observacoes String?
  status      String   @default("ABERTA") // ABERTA | ATENDIDA | CANCELADA
  criadoEm    DateTime @default(now())

  lojaId  String
  loja    Loja     @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  escalas Escala[]
  inscricoes Inscricao[]
  convocacoes Convocacao[]
  convidados Diarista[] @relation("ConvidadosRequisicao")

  @@index([status])
  @@index([data])
}

// Diarista se candidata (inscreve) a uma requisição aberta de uma loja.
model Inscricao {
  id       String   @id @default(cuid())
  status   String   @default("PENDENTE") // PENDENTE | ACEITA
  criadoEm DateTime @default(now())

  requisicaoId String
  requisicao   Requisicao @relation(fields: [requisicaoId], references: [id], onDelete: Cascade)
  diaristaId   String
  diarista     Diarista   @relation(fields: [diaristaId], references: [id], onDelete: Cascade)

  @@unique([requisicaoId, diaristaId])
  @@index([diaristaId])
}

// Avaliação de uma diária (escala): notas de 0 a 10 por aspecto.
model Avaliacao {
  id       String @id @default(cuid())
  estrelas Int    @default(0) // nota única de 1 a 5 (estilo iFood)
  // Aspectos detalhados (1-5). Os de cima são os critérios pedidos pelo RH.
  assiduidade  Int?
  pontualidade Int?
  padrao       Int?
  organizacao  Int?
  qualidade    Int?
  limpeza      Int?
  comunicacao  Int?
  // Aspectos antigos (0-10) ficam só para histórico.
  educacao          Int?
  rapidez           Int?
  habilidadeTecnica Int?
  respeito          Int?
  espiritoEquipe    Int?
  comentario        String?
  criadoEm          DateTime @default(now())

  escalaId String @unique
  escala   Escala @relation(fields: [escalaId], references: [id], onDelete: Cascade)

  diaristaId String
  diarista   Diarista @relation(fields: [diaristaId], references: [id], onDelete: Cascade)

  @@index([diaristaId])
}

// Convocação/convite: a loja ou o RH convidam um diarista para uma data; ele aceita ou recusa.
// Quando aceita, vira uma Escala (alocado). Carrega os dados da vaga (horário/valor/requisição)
// para que a diária criada no aceite saia certinha.
model Convocacao {
  id         String   @id @default(cuid())
  data       String // "AAAA-MM-DD"
  status     String   @default("PENDENTE") // PENDENTE | ACEITA | RECUSADA | CANCELADA (vaga preenchida)
  horaInicio String? // "HH:MM" (quando veio de uma requisição/sugestão)
  horaFim    String? // "HH:MM"
  valor      Int? // centavos; null = usa o valor padrão da diarista
  criadoEm   DateTime @default(now())

  lojaId String
  loja   Loja   @relation(fields: [lojaId], references: [id], onDelete: Cascade)

  diaristaId String
  diarista   Diarista @relation(fields: [diaristaId], references: [id], onDelete: Cascade)

  requisicaoId String?
  requisicao   Requisicao? @relation(fields: [requisicaoId], references: [id], onDelete: SetNull)

  @@index([lojaId])
  @@index([diaristaId])
  @@index([requisicaoId])
}

// Bloqueio de um diarista em uma loja.
// origem LOJA: temporário (campo "ate" com data). origem RH: permanente (ate = null).
model Bloqueio {
  id         String    @id @default(cuid())
  origem     String // LOJA | RH
  ate        DateTime? // null = permanente
  motivo     String?
  criadoEm   DateTime  @default(now())

  lojaId String
  loja   Loja   @relation(fields: [lojaId], references: [id], onDelete: Cascade)

  diaristaId String
  diarista   Diarista @relation(fields: [diaristaId], references: [id], onDelete: Cascade)

  @@index([lojaId])
  @@index([diaristaId])
}

// Avaliação da LOJA feita pelo diarista após a diária.
// Visível apenas na área de gestão (RH/devs) — não aparece para lojista nem diarista.
model AvaliacaoLoja {
  id             String   @id @default(cuid())
  ambiente       Int
  tratamento     Int
  pagamentoEmDia Int
  organizacao    Int
  seguranca      Int
  comentario     String?
  criadoEm       DateTime @default(now())

  escalaId String @unique
  escala   Escala @relation(fields: [escalaId], references: [id], onDelete: Cascade)

  lojaId String
  loja   Loja   @relation(fields: [lojaId], references: [id], onDelete: Cascade)

  diaristaId String
  diarista   Diarista @relation(fields: [diaristaId], references: [id], onDelete: Cascade)

  @@index([lojaId])
}

// ============================================================================
// PAINEL DO GESTOR — schema da seção 4 do /docs/BUILD_BOOK.md
// ============================================================================
// Os nomes de tabela e de coluna são EXATAMENTE os do book (via @@map/@map),
// para que as fórmulas da seção 6 e os testes da seção 11 mapeiem 1:1.
//
// Adaptações necessárias por este repo ser Next.js + Prisma (e não Supabase):
//  - `profiles` também guarda o login (email/senha), porque não existe o
//    `auth.users` do Supabase. O `id` do profile é o `user_id` do book.
//  - RLS do Postgres vira checagem de papel na camada de dados
//    (src/lib/painel/papeis.ts), com a mesma regra da seção 3.
//  - `updated_at` usa @updatedAt do Prisma no lugar do trigger SQL.
//  - Os `check (... in ...)` do book viram enums do Postgres com os MESMOS
//    valores em texto.
//  - `stores.loja_id` é o único campo fora do book: liga a loja do Painel à
//    loja já cadastrada no app de diaristas, para não haver dois cadastros.
//
// Dinheiro e quantidades usam `numeric` (Decimal), como o book pede — diferente
// do app de diaristas, que usa centavos inteiros.
// ============================================================================

enum PapelPainel {
  admin_rede
  gestor
  gerente
  equipe
  auditor
  cd

  @@map("papel_painel")
}

enum FuncaoEmpregado {
  producao
  atendimento
  lider_producao
  gerente
  diarista
  entregador

  @@map("funcao_empregado")
}

enum RegimeEmpregado {
  SEIS_POR_UM  @map("6x1")
  CINCO_POR_DOIS @map("5x2")
  diarista

  @@map("regime_empregado")
}

enum UnidadeIngrediente {
  kg
  bola
  un

  @@map("unidade_ingrediente")
}

enum TamanhoReceita {
  G
  P
  broto

  @@map("tamanho_receita")
}

enum CategoriaReceita {
  salgada
  doce
  borda

  @@map("categoria_receita")
}

enum StatusUpload {
  recebido
  processado
  alerta
  rejeitado

  @@map("status_upload")
}

enum TipoPedido {
  D
  B

  @@map("tipo_pedido")
}

enum TipoItemVendido {
  produto
  metade
  borda
  bebida
  outro

  @@map("tipo_item_vendido")
}

// P=presente A=atraso F=falta T=atestado O=folga S=saída antecipada
enum StatusPresenca {
  P
  A
  F
  T
  O
  S

  @@map("status_presenca")
}

enum OrigemPresenca {
  ponto
  gerente

  @@map("origem_presenca")
}

enum StatusCmv {
  ok
  bloco
  pendente

  @@map("status_cmv")
}

enum NomeChecklist {
  Abertura
  Pico
  Fechamento

  @@map("nome_checklist")
}

enum StatusSemana {
  aberta
  fechada
  aprovada
  paga

  @@map("status_semana")
}

enum TipoAuditoria {
  nutricao
  rede

  @@map("tipo_auditoria")
}

// ---------------------------------------------------------------- organização

model Brand {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid

  stores Store[]

  @@map("brands")
}

model Store {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  brandId   String?  @map("brand_id") @db.Uuid
  name      String
  shortName String?  @map("short_name")
  cnpj      String?
  address   String?
  city      String?
  openTime  DateTime? @map("open_time") @db.Time(0)
  closeTime DateTime? @map("close_time") @db.Time(0)
  tz        String   @default("America/Fortaleza")
  active    Boolean  @default(true)
  // Fora do book: liga à loja já cadastrada no app de diaristas.
  lojaId    String?  @unique @map("loja_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid

  brand Brand? @relation(fields: [brandId], references: [id], onDelete: SetNull)
  loja  Loja?  @relation(fields: [lojaId], references: [id], onDelete: SetNull)

  memberships         Membership[]
  employees           Employee[]
  shifts              Shift[]
  params              Param[]
  recipes             Recipe[]
  uploads             Upload[]
  orders              Order[]
  itemsSold           ItemSold[]
  dailyClose          DailyClose[]
  productionHours     ProductionHour[]
  statusTimes         StatusTime[]
  courierSettlements  CourierSettlement[]
  customers           Customer[]
  ifoodOrders         IfoodOrder[]
  ifoodMetrics        IfoodMetric[]
  attendance          Attendance[]
  stockCounts         StockCount[]
  cdDeliveries        CdDelivery[]
  internalConsumption InternalConsumption[]
  cmvDaily            CmvDaily[]
  cmvItemDaily        CmvItemDaily[]
  weekTargets         WeekTarget[]
  weekIndicators      WeekIndicator[]
  checklistTemplates  ChecklistTemplate[]
  checklistMarks      ChecklistMark[]
  weekSettlements     WeekSettlement[]
  leaderMonths        LeaderMonth[]
  managerMonths       ManagerMonth[]
  audits              Audit[]
  weighings           Weighing[]
  gamificationPoints  GamificationPoint[]
  alerts              Alert[]
  aiAnalyses          AiAnalysis[]
  tvTokens            TvToken[]

  @@map("stores")
}

// No book este é o `profiles` ligado ao auth do Supabase. Aqui ele também
// guarda o login, porque a autenticação é própria (cookie assinado).
model Profile {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  phone      String?
  avatarUrl  String?  @map("avatar_url")
  email      String   @unique
  senha      String? // hash; null = primeiro acesso pelo link
  tokenSenha String?  @unique @map("token_senha")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy  String?  @map("created_by") @db.Uuid

  memberships Membership[]

  @@map("profiles")
}

model Membership {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  storeId   String      @map("store_id") @db.Uuid
  role      PapelPainel
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?     @map("created_by") @db.Uuid

  user  Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId])
  @@index([storeId])
  @@map("memberships")
}

// ------------------------------------------------------------ equipe e turnos

model Employee {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId        String           @map("store_id") @db.Uuid
  name           String
  role           FuncaoEmpregado
  regime         RegimeEmpregado
  shiftPref      String?          @map("shift_pref")
  admissionDate  DateTime?        @map("admission_date") @db.Date
  monthlyCost    Decimal?         @map("monthly_cost") @db.Decimal(14, 2)
  dailyRate      Decimal?         @map("daily_rate") @db.Decimal(14, 2)
  active         Boolean          @default(true)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy      String?          @map("created_by") @db.Uuid

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  attendance Attendance[]
  payouts    Payout[]
  leaderMonths  LeaderMonth[]
  managerMonths ManagerMonth[]
  disputes      Dispute[]
  gamificationPoints GamificationPoint[]

  @@index([storeId])
  @@map("employees")
}

// store_id null = turno da rede.
// A 14:00-23:00 (15:30-16:30), A2 14:30-23:30, C 15:30-00:30 (16:30-17:30),
// B 17:00-02:00 (22:00-23:00)
model Shift {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId    String?   @map("store_id") @db.Uuid
  code       String
  label      String
  startTime  DateTime  @map("start_time") @db.Time(0)
  endTime    DateTime  @map("end_time") @db.Time(0)
  breakStart DateTime? @map("break_start") @db.Time(0)
  breakEnd   DateTime? @map("break_end") @db.Time(0)
  paidHours  Decimal   @map("paid_hours") @db.Decimal(6, 2)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy  String?   @map("created_by") @db.Uuid

