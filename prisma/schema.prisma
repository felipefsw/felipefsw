// Contestação em até 48 h depois do fechamento.
model Dispute {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  settlementId String   @map("settlement_id") @db.Uuid
  employeeId   String   @map("employee_id") @db.Uuid
  text         String
  status       String   @default("aberta")
  resolvedBy   String?  @map("resolved_by") @db.Uuid
  resolution   String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy    String?  @map("created_by") @db.Uuid

  settlement WeekSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  employee   Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([settlementId])
  @@map("disputes")
}

// ----------------------------------- auditoria, gamificação, alertas e IA

model Audit {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId   String        @map("store_id") @db.Uuid
  auditDate DateTime      @map("audit_date") @db.Date
  kind      TipoAuditoria
  score     Decimal?      @db.Decimal(7, 3)
  blocks    Json?
  photos    String[]
  auditorId String?       @map("auditor_id") @db.Uuid
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?       @map("created_by") @db.Uuid

  store     Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  weighings Weighing[]

  @@index([storeId, auditDate])
  @@map("audits")
}

model Weighing {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId   String   @map("store_id") @db.Uuid
  auditId   String?  @map("audit_id") @db.Uuid
  recipeId  String   @map("recipe_id") @db.Uuid
  expectedG Decimal  @map("expected_g") @db.Decimal(12, 3)
  measuredG Decimal  @map("measured_g") @db.Decimal(12, 3)
  ok        Boolean
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid

  store  Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  audit  Audit? @relation(fields: [auditId], references: [id], onDelete: SetNull)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@map("weighings")
}

model GamificationRule {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key       String
  points    Int
  validFrom DateTime @map("valid_from") @db.Date
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid

  @@unique([key, validFrom])
  @@map("gamification_rules")
}

// employee_id null = ponto da loja (não de uma pessoa).
model GamificationPoint {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId    String   @map("store_id") @db.Uuid
  weekStart  DateTime @map("week_start") @db.Date
  employeeId String?  @map("employee_id") @db.Uuid
  key        String
  points     Int
  detail     String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy  String?  @map("created_by") @db.Uuid

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([storeId, weekStart])
  @@map("gamification_points")
}

