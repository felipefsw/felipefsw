// Banco de dados do app de gestão de diaristas.
// Em desenvolvimento usamos Postgres local; em produção, o Postgres da Vercel.
// Valores em dinheiro são guardados em CENTAVOS (inteiro) para evitar erros de arredondamento.
// Datas de trabalho são guardadas como texto "AAAA-MM-DD" para evitar confusão de fuso horário.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Em runtime usamos a conexão "pooled" (com pgbouncer).
  // Nomes criados automaticamente pela integração Vercel + Supabase.
  url       = env("POSTGRES_PRISMA_URL")
  // Para rodar migrations precisamos de uma conexão direta (sem pooler).
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model Loja {
  id          String       @id @default(cuid())
  nome        String
  cnpj        String?
  senha       String       @default("123456") // hash da senha (login por nome + senha)
  tokenSenha  String?      @unique // link secreto p/ definir/resetar a senha (1º acesso)
  cidade      String?
  bairro      String?
  endereco    String?
  latitude    Float?
  longitude   Float?
  ativo       Boolean      @default(true)
  // Se true, a loja assume o risco e permite o mesmo diarista fazer mais de 2 diárias na semana.
  permiteMais2Semana Boolean @default(false)
  fotos       String[]     @default([]) // até 5 fotos do ambiente (URLs)
  vantagens   String? // texto com as vantagens de fazer diária nesta loja
  criadoEm    DateTime     @default(now())
  gestores    Gestor[]     @relation("GestorLojas") // uma loja pode ter vários gestores (sócios)
  escalas     Escala[]
  requisicoes Requisicao[]
  avaliacoesRecebidas AvaliacaoLoja[]
  bloqueios   Bloqueio[]
  convocacoes Convocacao[]
  diaristasPreferem Diarista[] @relation("LojaPreferida")
  diaristasNoBanco BancoLoja[]
  pushLojas   PushLoja[]
  execAgentes ExecAgente[]
}

// Banco/pool de diaristas de cada loja: só os diaristas listados aqui podem
// ser alocados/convocados por aquela loja (ou gestor dela). RH/TI veem todas.
// Diaristas entram aqui via: cadastro vindo do link da loja, aprovação por
// gestor/loja, ou (na migração) histórico de escalas.
model BancoLoja {
  lojaId     String
  diaristaId String
  criadoEm   DateTime @default(now())
  loja       Loja     @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  diarista   Diarista @relation(fields: [diaristaId], references: [id], onDelete: Cascade)

  @@id([lojaId, diaristaId])
  @@index([lojaId])
  @@index([diaristaId])
}

// Inscrição de push da loja/gestor (para lembrete de pagamento, etc.).
model PushLoja {
  id       String   @id @default(cuid())
  endpoint String   @unique
  p256dh   String
  auth     String
  criadoEm DateTime @default(now())
  lojaId   String
  loja     Loja     @relation(fields: [lojaId], references: [id], onDelete: Cascade)

  @@index([lojaId])
}

// Valor padrão da diária por função (definido pelo RH).
model ValorFuncao {
  id     String @id @default(cuid())
  funcao String @unique
  valor  Int    @default(0) // centavos
}

// Gestor: pessoa que administra uma ou mais lojas. Loga com usuário + senha.
model Gestor {
  id         String   @id @default(cuid())
  nome       String
  usuario    String   @unique
  senha      String   @default("123456")
  tokenSenha String?  @unique // link secreto p/ definir/resetar a senha
  telefone   String? // WhatsApp (para receber o link de acesso)
  aprovado   Boolean  @default(true) // autocadastro entra como false até o RH/TI aprovar
  ativo      Boolean  @default(true)
  criadoEm   DateTime @default(now())
  lojas      Loja[]   @relation("GestorLojas")
}

// Pessoa da equipe interna (RH ou TI). Loga clicando no nome + senha.
model Membro {
  id         String   @id @default(cuid())
  nome       String
  usuario    String   @unique
  perfil     String // "rh" | "ti"
  papel      String?
  senha      String? // hash; null = primeiro acesso (define a senha pelo link)
  tokenSenha String?  @unique // link secreto p/ definir/resetar a senha
  ativo      Boolean  @default(true)
  criadoEm   DateTime @default(now())
}

model Diarista {
  id          String      @id @default(cuid())
  nome        String
  cpf         String?
  dataNascimento String? // "AAAA-MM-DD"
  fotoUrl     String?
  funcao      String? // Atendente | Pizzaiolo | Aux. pizzaiolo | Motoqueiro
  telefone    String?
  senha       String? // hash da senha (definida no primeiro acesso)
  chavePix    String?
  valorDiaria Int         @default(0) // centavos
  observacoes String?
  ativo       Boolean     @default(true)
  // Aprovação do RH para quem se autocadastrou pelo link. Cadastros antigos e os
  // criados pelo próprio RH nascem aprovados (default true); autocadastro entra como false.
  aprovado    Boolean     @default(true)
  // Bloqueio GLOBAL (RH): a diarista não recebe nenhuma diária enquanto estiver no futuro.
  // null = não bloqueada. Data bem distante = "para sempre".
  bloqueadoAte DateTime?
  // Motivo do bloqueio global (lista negra), para o RH lembrar depois.
  motivoBloqueio String?
  token       String      @unique @default(cuid()) // usado no link pessoal /d/[token]
  telegramChatId String? // vinculado quando a diarista inicia o bot do Telegram
  criadoEm    DateTime    @default(now())
  escalas     Escala[]
  avaliacoes  Avaliacao[]
  avaliacoesDeLoja AvaliacaoLoja[]
  inscricoes  Inscricao[]
  bloqueios   Bloqueio[]
  convocacoes Convocacao[]
  bonificacoes Bonificacao[]
  convidadoEm Requisicao[] @relation("ConvidadosRequisicao")
  pushSubscriptions PushSubscription[]
  mensagens   Mensagem[]
  // Lojas que a diarista prefere trabalhar (apenas um norte, não obriga).
  lojasPreferidas Loja[] @relation("LojaPreferida")
  // Lojas no banco/escopo desta diarista — só essas lojas/gestores podem
  // alocar/convocar. (RH/TI veem todas.) Vazio = orfão, visível só pelo RH.
  lojasNoBanco BancoLoja[]
}

// Chat entre o diarista e o RH (avisos, dúvidas, imprevistos).
model Mensagem {
  id         String   @id @default(cuid())
  autor      String // DIARISTA | GESTAO
  texto      String
  lida       Boolean  @default(false)
  criadoEm   DateTime @default(now())
  diaristaId String
  diarista   Diarista @relation(fields: [diaristaId], references: [id], onDelete: Cascade)

  @@index([diaristaId])
}

// Inscrição de push web (um aparelho/navegador do diarista).
model PushSubscription {
  id         String   @id @default(cuid())
  endpoint   String   @unique
  p256dh     String
  auth       String
  criadoEm   DateTime @default(now())
  diaristaId String
  diarista   Diarista @relation(fields: [diaristaId], references: [id], onDelete: Cascade)

  @@index([diaristaId])
}

// Bonificação paga ao diarista: cashback (5 diárias com média alta) ou top do mês.
model Bonificacao {
  id         String    @id @default(cuid())
  tipo       String // CASHBACK_5 | TOP_MES
  valor      Int       @default(10000) // centavos (R$ 100,00)
  referencia String? // ex.: "2026-05" para o top do mês
  pago       Boolean   @default(false)
  pagoEm     DateTime?
  criadoEm   DateTime  @default(now())

  diaristaId String
  diarista   Diarista @relation(fields: [diaristaId], references: [id], onDelete: Cascade)

  @@index([diaristaId])
}

model Escala {
  id          String    @id @default(cuid())
  data        String // "AAAA-MM-DD"
  horaInicio  String? // "HH:MM"
  horaFim     String? // "HH:MM"
  valor       Int // centavos
  presenca    String    @default("PENDENTE") // PENDENTE | PRESENTE | FALTOU
  confirmadaEm DateTime? // diarista confirmou que vem (não é "realizada")
  pago        Boolean   @default(false)
  pagoEm      DateTime?
  observacoes String?
  tokenConfirmacao String? @unique // link público de confirmação (gerado pelo RH)
  checkinEm   DateTime?
  checkinLat  Float?
  checkinLng  Float?
  checkoutEm  DateTime?
  checkoutAuto Boolean  @default(false)
  valorPago   Int? // valor efetivo (proporcional se saiu antes); null até o check-out
  criadoEm    DateTime  @default(now())

  diaristaId String
  diarista   Diarista @relation(fields: [diaristaId], references: [id], onDelete: Cascade)
  lojaId     String
  loja       Loja     @relation(fields: [lojaId], references: [id], onDelete: Cascade)

  requisicaoId String?
  requisicao   Requisicao? @relation(fields: [requisicaoId], references: [id], onDelete: SetNull)

  avaliacao     Avaliacao?
  avaliacaoLoja AvaliacaoLoja?

  @@unique([diaristaId, data]) // 1 diária por diarista por dia (trava o furo de escala)
  @@index([data])
  @@index([lojaId])
}

// Pedido de diaristas feito por uma loja; o RH atende criando as escalas.
model Requisicao {
  id          String   @id @default(cuid())
  data        String // "AAAA-MM-DD" - dia em que a loja precisa
  horaInicio  String // "HH:MM"
  horaFim     String // "HH:MM"
  funcao      String? // função desejada (opcional)
  quantidade  Int      @default(1)
  valorDiaria Int // centavos - valor pago por diarista nessa requisição
  observacoes String?
  status      String   @default("ABERTA") // ABERTA | ATENDIDA | CANCELADA
  criadoEm    DateTime @default(now())

  lojaId  String
  loja    Loja     @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  escalas Escala[]
  inscricoes Inscricao[]
  convocacoes Convocacao[]
  convidados Diarista[] @relation("ConvidadosRequisicao")

  @@index([status])
  @@index([data])
}

// Diarista se candidata (inscreve) a uma requisição aberta de uma loja.
model Inscricao {
  id       String   @id @default(cuid())
  status   String   @default("PENDENTE") // PENDENTE | ACEITA
  criadoEm DateTime @default(now())

  requisicaoId String
  requisicao   Requisicao @relation(fields: [requisicaoId], references: [id], onDelete: Cascade)
  diaristaId   String
  diarista     Diarista   @relation(fields: [diaristaId], references: [id], onDelete: Cascade)

  @@unique([requisicaoId, diaristaId])
  @@index([diaristaId])
}

// Avaliação de uma diária (escala): notas de 0 a 10 por aspecto.
model Avaliacao {
  id       String @id @default(cuid())
  estrelas Int    @default(0) // nota única de 1 a 5 (estilo iFood)
  // Aspectos detalhados (1-5). Os de cima são os critérios pedidos pelo RH.
  assiduidade  Int?
  pontualidade Int?
  padrao       Int?
  organizacao  Int?
  qualidade    Int?
  limpeza      Int?
  comunicacao  Int?
  // Aspectos antigos (0-10) ficam só para histórico.
  educacao          Int?
  rapidez           Int?
  habilidadeTecnica Int?
  respeito          Int?
  espiritoEquipe    Int?
  comentario        String?
  criadoEm          DateTime @default(now())

  escalaId String @unique
  escala   Escala @relation(fields: [escalaId], references: [id], onDelete: Cascade)

  diaristaId String
  diarista   Diarista @relation(fields: [diaristaId], references: [id], onDelete: Cascade)

  @@index([diaristaId])
}

// Convocação/convite: a loja ou o RH convidam um diarista para uma data; ele aceita ou recusa.
// Quando aceita, vira uma Escala (alocado). Carrega os dados da vaga (horário/valor/requisição)
// para que a diária criada no aceite saia certinha.
model Convocacao {
  id         String   @id @default(cuid())
  data       String // "AAAA-MM-DD"
  status     String   @default("PENDENTE") // PENDENTE | ACEITA | RECUSADA | CANCELADA (vaga preenchida)
  horaInicio String? // "HH:MM" (quando veio de uma requisição/sugestão)
  horaFim    String? // "HH:MM"
  valor      Int? // centavos; null = usa o valor padrão da diarista
  criadoEm   DateTime @default(now())

  lojaId String
  loja   Loja   @relation(fields: [lojaId], references: [id], onDelete: Cascade)

  diaristaId String
  diarista   Diarista @relation(fields: [diaristaId], references: [id], onDelete: Cascade)

  requisicaoId String?
  requisicao   Requisicao? @relation(fields: [requisicaoId], references: [id], onDelete: SetNull)

  @@index([lojaId])
  @@index([diaristaId])
  @@index([requisicaoId])
}

// Bloqueio de um diarista em uma loja.
// origem LOJA: temporário (campo "ate" com data). origem RH: permanente (ate = null).
model Bloqueio {
  id         String    @id @default(cuid())
  origem     String // LOJA | RH
  ate        DateTime? // null = permanente
  motivo     String?
  criadoEm   DateTime  @default(now())

  lojaId String
  loja   Loja   @relation(fields: [lojaId], references: [id], onDelete: Cascade)

  diaristaId String
  diarista   Diarista @relation(fields: [diaristaId], references: [id], onDelete: Cascade)

  @@index([lojaId])
  @@index([diaristaId])
}

// Avaliação da LOJA feita pelo diarista após a diária.
// Visível apenas na área de gestão (RH/devs) — não aparece para lojista nem diarista.
model AvaliacaoLoja {
  id             String   @id @default(cuid())
  ambiente       Int
  tratamento     Int
  pagamentoEmDia Int
  organizacao    Int
  seguranca      Int
  comentario     String?
  criadoEm       DateTime @default(now())

  escalaId String @unique
  escala   Escala @relation(fields: [escalaId], references: [id], onDelete: Cascade)

  lojaId String
  loja   Loja   @relation(fields: [lojaId], references: [id], onDelete: Cascade)

  diaristaId String
  diarista   Diarista @relation(fields: [diaristaId], references: [id], onDelete: Cascade)

  @@index([lojaId])
}

// =====================================================================
// RWP Master OS — Agentes de IA (Auditor Financeiro, Mentor RH, P&D, etc).
// =====================================================================

// Definição de um Agente: identidade + System Prompt + modelo.
// Cada Agente é uma "Skill" reutilizável que pode ser executada várias vezes
// com entradas diferentes (ex.: o Auditor Financeiro processa um relatório do
// Saipos por vez). O System Prompt é editável pelo RH/TI pelo painel.
model Agente {
  id           String       @id @default(cuid())
  slug         String       @unique // ex.: "auditor-financeiro", "mentor-rh", "pd"
  nome         String
  descricao    String
  systemPrompt String       // texto longo, definido pelo RH/TI
  modelo       String       @default("claude-opus-4-7")
  ativo        Boolean      @default(true)
  criadoEm     DateTime     @default(now())
  atualizadoEm DateTime     @updatedAt
  execucoes    ExecAgente[]
}

// Cada execução de um Agente: registra a entrada bruta colada pelo usuário,
// a resposta do modelo (Markdown), e métricas (tokens, cache, duração).
model ExecAgente {
  id           String    @id @default(cuid())
  status       String    @default("PENDENTE") // PENDENTE | PROCESSANDO | CONCLUIDA | ERRO
  titulo       String? // rótulo livre (ex.: "Saipos — Centro — 28/05")
  entrada      String // texto bruto colado pelo usuário
  saida        String? // resposta do modelo (Markdown)
  erro         String?
  modelo       String?
  inputTokens  Int?
  outputTokens Int?
  cacheCreate  Int? // tokens criados em cache (prompt caching)
  cacheRead    Int? // tokens lidos do cache (hit)
  duracaoMs    Int?
  criadoEm     DateTime  @default(now())
  concluidoEm  DateTime?

  agenteId String
  agente   Agente @relation(fields: [agenteId], references: [id], onDelete: Cascade)

  // Opcional: a qual loja o relatório/auditoria se refere. SetNull para preservar histórico.
  lojaId String?
  loja   Loja?   @relation(fields: [lojaId], references: [id], onDelete: SetNull)

  @@index([agenteId])
  @@index([lojaId])
  @@index([criadoEm])
}
