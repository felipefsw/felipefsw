// store_id null = modelo da rede.
model ChecklistTemplate {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId   String?       @map("store_id") @db.Uuid
  name      NomeChecklist
  active    Boolean       @default(true)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?       @map("created_by") @db.Uuid

  store Store?          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items ChecklistItem[]

  @@unique([storeId, name])
  @@map("checklist_templates")
}

model ChecklistItem {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateId         String   @map("template_id") @db.Uuid
  position           Int
  text               String
  referencePhotoPath String?  @map("reference_photo_path")
  requiresPhoto      Boolean  @default(false) @map("requires_photo")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy          String?  @map("created_by") @db.Uuid

  template ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  marks    ChecklistMark[]

  @@unique([templateId, position])
  @@map("checklist_items")
}

model ChecklistMark {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId      String    @map("store_id") @db.Uuid
  opsDate      DateTime  @map("ops_date") @db.Date
  itemId       String    @map("item_id") @db.Uuid
  done         Boolean   @default(false)
  doneAt       DateTime? @map("done_at") @db.Timestamptz(6)
  doneBy       String?   @map("done_by") @db.Uuid
  evidencePath String?   @map("evidence_path")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy    String?   @map("created_by") @db.Uuid

  store Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  item  ChecklistItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([storeId, opsDate, itemId])
  @@index([storeId, opsDate])
  @@map("checklist_marks")
}

// aberta -> fechada (domingo 06h05) -> aprovada (gestor) -> paga
model WeekSettlement {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId        String       @map("store_id") @db.Uuid
  weekStart      DateTime     @map("week_start") @db.Date
  status         StatusSemana @default(aberta)
  gates          Json?
  teamPrizes     Json?        @map("team_prizes")
  hitTargets     Int?         @map("hit_targets")
  measuredTargets Int?        @map("measured_targets")
  totalPayout    Decimal?     @map("total_payout") @db.Decimal(14, 2)
  closedAt       DateTime?    @map("closed_at") @db.Timestamptz(6)
  approvedBy     String?      @map("approved_by") @db.Uuid
  paidAt         DateTime?    @map("paid_at") @db.Timestamptz(6)
  paramsVersion  DateTime?    @map("params_version") @db.Date
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy      String?      @map("created_by") @db.Uuid

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  payouts  Payout[]
  disputes Dispute[]

  @@unique([storeId, weekStart])
  @@map("week_settlements")
}

model Payout {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  settlementId String   @map("settlement_id") @db.Uuid
  employeeId   String   @map("employee_id") @db.Uuid
  eligible     Boolean  @default(false)
  reasons      String[]
  presence     Decimal? @db.Decimal(14, 2)
  cmv          Decimal? @db.Decimal(14, 2)
  pizzas       Decimal? @db.Decimal(14, 2)
  quality      Decimal? @db.Decimal(14, 2)
  excellence   Decimal? @db.Decimal(14, 2)
  streak       Decimal? @db.Decimal(14, 2)
  total        Decimal? @db.Decimal(14, 2)
  streakWeeks  Int?     @map("streak_weeks")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy    String?  @map("created_by") @db.Uuid

  settlement WeekSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  employee   Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([settlementId, employeeId])
  @@map("payouts")
}

model LeaderMonth {
