# Conexão com o banco de dados Postgres.
#
# São duas variáveis (nomes usados pela integração Vercel + Supabase):
#   POSTGRES_PRISMA_URL      = conexão "pooled" (pgbouncer) — usada pelo app em runtime
#   POSTGRES_URL_NON_POOLING = conexão direta (sem pooler)  — usada para rodar as migrations
#
# Em produção (Vercel), essas variáveis são criadas AUTOMATICAMENTE ao conectar o
# banco (Supabase/Vercel Postgres) — você não precisa criar nada à mão.
#
# Em desenvolvimento local as duas podem ser IGUAIS, apontando para o seu Postgres.
POSTGRES_PRISMA_URL="postgresql://USUARIO:SENHA@HOST:5432/NOME_DO_BANCO?schema=public"
POSTGRES_URL_NON_POOLING="postgresql://USUARIO:SENHA@HOST:5432/NOME_DO_BANCO?schema=public"

# Senha da área de gestão (RH/TI). Padrão 123456 se não definir.
# RH_SENHA="..."
# TI_SENHA="..."

# Segredo que assina o login (sessão). Defina uma frase longa aleatória em produção.
# SESSION_SECRET="troque-isto-por-algo-bem-aleatorio"

# Push web (notificações). Gere com: npx web-push generate-vapid-keys
# A pública vai no cliente (NEXT_PUBLIC_), a privada fica só no servidor.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:voce@exemplo.com"

# Telegram (notificações por bot). Crie o bot no @BotFather e cole o token.
# TELEGRAM_BOT_TOKEN=""
# Nome de usuário do bot (sem @), para o link de ativação no app.
# NEXT_PUBLIC_TELEGRAM_BOT=""

# Endereço público do app (ex.: https://seu-app.vercel.app). Usado para montar links
# completos nas mensagens do Telegram (ex.: confirmar presença). Na Vercel é detectado
# automaticamente; defina só se quiser fixar um domínio próprio.
# NEXT_PUBLIC_BASE_URL=""

# Segredo do cron de check-out automático (opcional).
# CRON_SECRET=""

# RWP Master OS — chave da API do Claude (Anthropic). Obtenha em
# https://console.anthropic.com/. Sem ela, as Skills (Auditor Financeiro etc.)
# não conseguem rodar.
# ANTHROPIC_API_KEY=""
